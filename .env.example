# .env.example (VPS friendly)
#
# 用法：
# - 复制为 .env 并填入真实值
# - VPS 通常不需要代理，不要填你电脑上的 127.0.0.1:7897（那是本机 Clash）

# ── 必填：Discord ─────────────────────
DISCORD_TOKEN=your_discord_bot_token
OWNER_ID=your_discord_user_id

# ── 必填：LLM（当前项目默认优先 DeepSeek） ─────────────
DEEPSEEK_API_KEY=your_deepseek_api_key
# 可选：Gemini（如果你安装了 requirements.gemini.txt 才需要）
# GEMINI_API_KEY=your_gemini_api_key

# ── 可选：HTTP 代理（仅在 VPS 必须走代理时填写） ─────────
# PROXY=http://127.0.0.1:7897
# 兼容旧写法（仅端口，默认 127.0.0.1）：
# PROXY_PORT=7897

# ── 可选：安全限流参数 ──────────────────
# MAX_INPUT_LEN 默认 500
MAX_INPUT_LEN=500
# COOLDOWN_SECONDS 默认 30
COOLDOWN_SECONDS=30
# COOLDOWN_MAX 默认 2
COOLDOWN_MAX=2
# GLOBAL_MAX_RPM 默认 20
GLOBAL_MAX_RPM=20

# ── 可选：Token 日预算（超出后停止 API 调用） ─────────────
DAILY_TOKEN_BUDGET=15000

# ── 可选：RSS ──────────────────────────
# 北京时间早上 9 点 = UTC 1 点
DAILY_HOUR_UTC=1

# ── 频道配置说明 ───────────────────────
# 当前频道角色主要从 guilds/{guild_id}/config.json 读取（推荐用 setup_guild.py 初始化）。
# 下面这些属于旧兼容/可选项：不配也能跑。
#
# SOLO_CHANNEL_IDS=123456789,987654321
# CHAT_CHANNELS=123456789
# RSS_CHANNELS=123456789
# LOG_CHANNELS=123456789
# FORUM_CHANNELS=123456789
# MEMO_CHANNELS=123456789
