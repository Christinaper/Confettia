# 密钥（最重要）
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
venv/

# 数据库（含对话历史，属于隐私）
*.db
*.db-wal
*.db-shm
*.db-journal
*.db.backup*

# Codex
.codex

# 系统文件
.DS_Store
Thumbs.db

# Doc
doc/

# 向量索引（很大）
chroma_db/

# 归档（含对话内容）
archive/

# Guild 数据库（配置可以上传，数据不行）
guilds/*/data.db
guilds/*/data.db-wal
guilds/*/data.db-shm
guilds/*/chroma/

# 日志
*.log
bot.log
